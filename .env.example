# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for Paystack redirect callbacks and return URLs.
APP_URL="http://localhost:3000"

# PAYSTACK TEST / LIVE CREDENTIALS
# Get your API keys from Paystack Dashboard > Settings > API Keys & Webhooks:
# - Test Public Key starts with: pk_test_...
# - Test Secret Key starts with: sk_test_...
# You can also configure them directly in the app via the "Paystack Key" button.
PAYSTACK_PUBLIC_KEY="pk_test_sample_career_ke"
PAYSTACK_SECRET_KEY="sk_test_sample_career_ke"

# ADMIN_SECRET: Secret passkey for managing KUCCPS database & viewing analytics
ADMIN_SECRET="admin_ke_2026"
